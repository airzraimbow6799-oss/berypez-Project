# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.
# Las variables NEXT_PUBLIC_* llegan al navegador: solo valores públicos.

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (proyecto berypez-dev). Supabase → Project Settings → API Keys.
# La publishable (sb_publishable_…) es pública y está protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETA (sb_secret_…): solo servidor (/api/* y scripts). Salta RLS.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile. Claves de prueba que siempre aprueban:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# SECRETA: solo servidor.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend. SECRETA: solo servidor, con permiso solo de envío.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Berypez <pedidos@tu-dominio.pe>"

# SECRETO, solo local: token personal para npm run db:push / db:types.
# supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
